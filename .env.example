# Runtime & System
NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL="file:./dev.db"

# AI Configuration
AI_MODE=openai # 'openai', 'gemini', or 'mock'
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TEXT_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Publishing Engine Settings
PUBLISHING_MODE=simulated # 'simulated', 'live', or 'hybrid'
ALLOW_LIVE_PUBLISHING=false
ALLOW_PUBLISH_NOW=true
ALLOW_SCHEDULED_LIVE_PUBLISHING=false
FALLBACK_TO_SIMULATOR=true

# Encryption Key for OAuth Tokens (32 bytes hex or random secret)
OAUTH_STATE_SECRET=aicas_super_secret_state_token_key_12345
PLATFORM_TOKEN_ENCRYPTION_KEY=39f847291a58c40b2e3194a8f9021c4b

# LinkedIn Connector (OAuth 2.0 & API)
LINKEDIN_ENABLED=false
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/integrations/linkedin/callback
LINKEDIN_API_VERSION=202601
LINKEDIN_DEFAULT_AUTHOR_URN=

# Facebook & Instagram Connector (Meta Graph API)
FACEBOOK_ENABLED=false
META_APP_ID=
META_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/integrations/facebook/callback
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=

# Telegram Connector (Bot API)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Metrics
ENABLE_PLATFORM_METRIC_SYNC=false
METRIC_SYNC_INTERVAL_MINUTES=60
