generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   @default("MARKETING_MANAGER")
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brands     Brand[]
  approvals  Approval[]
  auditEvents AuditEvent[]
  preferences UserPreferences?
}

model UserPreferences {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme                   String   @default("system")
  density                 String   @default("comfortable")
  sidebarDefault          String   @default("expanded")
  reducedMotion           Boolean  @default(false)
  timezone                String   @default("UTC")
  locale                  String   @default("en-US")
  dateFormat              String   @default("YYYY-MM-DD")
  timeFormat              String   @default("24h")
  firstDayOfWeek          String   @default("monday")
  defaultBrandId          String?
  defaultApprovalMode     String   @default("APPROVAL_REQUIRED")
  defaultCalendarView     String   @default("month")
  defaultLanguage         String   @default("en-US")
  defaultReportingPeriod  String   @default("30d")
  allowedAiProvider       String   @default("gemini")
  allowedDefaultTextModel String   @default("gemini-2.5-flash")
  allowedImageModel       String   @default("imagen-3")
  executionMode           String   @default("mock")
  fallbackBehavior        String   @default("mock_fallback")
  costWarningThresholdUsd Float    @default(250.0)
  notifyApprovals         Boolean  @default(true)
  notifyFailures          Boolean  @default(true)
  notifyCredentialWarnings Boolean @default(true)
  notifyCampaignCompletion Boolean @default(true)
  notifyCostThreshold     Boolean  @default(true)
  notifyRiskEscalation    Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Brand {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  industry            String
  description         String
  products            String // Comma or newline separated
  targetAudience      String
  personality         String
  tone                String
  preferredVocabulary String // Comma separated
  prohibitedPhrases   String // Comma separated
  requiredDisclaimers String // Comma separated
  defaultCTA          String
  region              String   @default("Global")
  language            String   @default("en-US")
  brandColors         String   @default("#6366f1,#4f46e5")
  competitors         String?
  originalWebsiteUrl  String?
  canonicalWebsiteUrl String?
  normalizedDomain    String?
  isArchived          Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  ingestionSources    IngestionSource[]
  knowledgeDocs       BrandKnowledgeDocument[]
  knowledgeChunks     KnowledgeChunk[]
  campaigns           Campaign[]
  platformConnections PlatformConnection[]
  auditEvents         AuditEvent[]
}

model IngestionSource {
  id               String   @id @default(cuid())
  brandId          String
  brand            Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  sourceType       String   // 'website_url', 'document', 'rss'
  sourceUrl        String?
  title            String
  extractedContent String
  extractedMetadataJson String? // JSON metadata (tone, audience, topics extracted)
  status           String   @default("COMPLETED") // 'PENDING', 'COMPLETED', 'FAILED'
  createdAt        DateTime @default(now())
}

model BrandKnowledgeDocument {
  id          String   @id @default(cuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  filename    String
  fileType    String   // 'pdf', 'txt', 'md'
  fileSize    Int
  extractedText String
  charCount   Int
  chunkCount  Int
  status      String   @default("PROCESSED") // 'PENDING', 'PROCESSED', 'FAILED'
  uploadedAt  DateTime @default(now())

  chunks KnowledgeChunk[]
}

model KnowledgeChunk {
  id          String                 @id @default(cuid())
  documentId  String
  document    BrandKnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  brandId     String
  brand       Brand                  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  chunkIndex  Int
  content     String
  charCount   Int
  embeddingJson String?              // JSON array of embedding floats
  createdAt   DateTime               @default(now())
}

model Campaign {
  id               String   @id @default(cuid())
  brandId          String
  brand            Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name             String
  objective        String   // 'awareness', 'engagement', 'webinar_registrations', 'qualified_leads', 'event_attendance', 'product_trial'
  productOrTopic   String
  description      String
  targetAudience   String
  offerCTA         String
  startDate        DateTime
  endDate          DateTime
  channels         String   // Comma separated e.g. "linkedin,facebook,instagram,telegram"
  region           String   @default("en-US")
  language         String   @default("en-US")
  textPostCount    Int      @default(3)
  imageBriefCount  Int      @default(2)
  carouselCount    Int      @default(1)
  postingFrequency String   @default("daily")
  requiredMessages String?
  prohibitedThemes String?
  groundingRequired Boolean @default(true)
  approvalRequired Boolean  @default(true)
  oversightMode    String   @default("APPROVAL_REQUIRED") // 'COPILOT', 'APPROVAL_REQUIRED', 'RISK_BASED', 'AUTONOMOUS'
  status           String   @default("PLANNING") // 'PLANNING', 'STRATEGY_GENERATED', 'CONTENT_GENERATED', 'IN_REVIEW', 'APPROVED', 'ACTIVE', 'COMPLETED'
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  strategy     CampaignStrategy?
  contentItems ContentItem[]
  schedules    Schedule[]
  auditEvents  AuditEvent[]
}

model CampaignStrategy {
  id                     String   @id @default(cuid())
  campaignId             String   @unique
  campaign               Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  version                Int      @default(1)
  status                 String   @default("APPROVED") // 'DRAFT', 'APPROVED', 'SUPERSEDED'
  objectiveInterpretation String
  audienceSummary        String
  campaignNarrative      String
  contentPillarsJson     String   // JSON array of pillar objects [{name, angle, rationale}]
  channelRolesJson       String   // JSON object mapping channel to role
  publishingCadence      String
  contentIdeasJson       String   // JSON array of content idea titles
  constraintsJson        String   // JSON array of constraints
  retrievedEvidenceJson  String?  // JSON array of source refs
  sourceFreshnessJson    String?  // JSON array of source freshness metadata
  confidence             Float    @default(0.95)
  limitations            String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model ContentItem {
  id             String   @id @default(cuid())
  campaignId     String
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title          String
  coreIdea       String
  targetAudience String
  contentPillar  String
  format         String   // 'text_post', 'image_post', 'carousel', 'video_script'
  defaultCTA     String
  status         String   @default("DRAFT") // 'DRAFT', 'NEEDS_REVISION', 'APPROVED', 'SCHEDULED', 'PUBLISHED', 'REJECTED'
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  variants     ContentVariant[]
  reviewResult ReviewResult?
  approvals    Approval[]
  schedules    Schedule[]
  publications Publication[]
}

model ContentVariant {
  id            String      @id @default(cuid())
  contentItemId String
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  channel       String      // 'linkedin', 'facebook', 'instagram', 'telegram'
  headline      String?
  hook          String
  bodyText      String
  ctaText       String
  hashtags      String?     // Comma separated
  altText       String?
  visualConcept String?     // For image/video briefs
  carouselSlidesJson String? // JSON array of slide objects [{slideNumber, title, content, visualDirection}]
  imageBriefJson String?    // JSON object for high-res image brief & prompt specs
  infographicSpecsJson String? // JSON object for infographic data points & flow
  staticVisualJson String?  // JSON object for static quote/stat visual card
  evidenceRefsJson String?  // JSON array of evidence citations
  status        String      @default("GENERATED")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model ReviewResult {
  id                   String      @id @default(cuid())
  contentItemId        String      @unique
  contentItem          ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  brandScore           Int         // 0 - 100
  factualRiskScore     Int         // 0 - 100
  complianceScore      Int         // 0 - 100
  originalityScore     Int         // 0 - 100
  readabilityScore     Int         // 0 - 100
  overallStatus        String      // 'passed', 'needs_revision', 'blocked'
  confidence           Float       @default(0.95)
  freshnessStatus      String      @default("CURRENT") // 'CURRENT', 'STALE', 'EVALUATING', 'FAILED'
  brandPolicyVersion   String      @default("v1.0")
  evaluatorVersion     String      @default("v1.0")
  dimensionScoresJson  String?     // JSON breakdown of 8 brand dimensions & claim verification
  claimsJson           String?     // JSON array of extracted claims & verification status
  evidenceCoverage     Float       @default(1.0)
  warningsJson         String      // JSON array of warning strings
  correctionsJson      String?     // JSON array of correction objects
  evidenceRefsJson     String?     // JSON array of evidence refs
  prohibitedTermsFound String?     // Comma separated
  missingDisclaimers   String?     // Comma separated
  duplicateSimilarity  Float       @default(0.0)
  evaluatedAt          DateTime    @default(now())
  reviewedAt           DateTime    @default(now())
}

model Approval {
  id            String      @id @default(cuid())
  contentItemId String
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  reviewerId    String?
  reviewer      User?       @relation(fields: [reviewerId], references: [id])
  decision      String      // 'APPROVED', 'REVISION_REQUESTED', 'REJECTED'
  comment       String?
  editedContent String?     // If modified during approval
  decidedAt     DateTime    @default(now())
}

model Schedule {
  id            String      @id @default(cuid())
  campaignId    String
  campaign      Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contentItemId String
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  channel       String      // 'linkedin', 'facebook', 'instagram', 'telegram'
  scheduledTime DateTime
  timezone      String      @default("UTC")
  status        String      @default("SCHEDULED") // 'SCHEDULED', 'PUBLISHING', 'PUBLISHED', 'FAILED', 'CANCELLED'
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  publications Publication[]
}

model Publication {
  id             String   @id @default(cuid())
  contentItemId  String
  contentItem    ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  scheduleId     String?
  schedule       Schedule?   @relation(fields: [scheduleId], references: [id])
  channel        String   // 'linkedin', 'facebook', 'instagram', 'telegram'
  publishingMode String   // 'simulated', 'live'
  externalPostId String?
  permalink      String?
  status         String   // 'SUCCESS', 'FAILED', 'RETRYING'
  idempotencyKey String   @unique
  publishedAt    DateTime @default(now())

  attempts        PublicationAttempt[]
  metricsSnapshots MetricsSnapshot[]
}

model PublicationAttempt {
  id            String      @id @default(cuid())
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  attemptNumber Int
  status        String      // 'SUCCESS', 'FAILED'
  errorDetails  String?
  requestPayloadJson String?
  responsePayloadJson String?
  attemptedAt   DateTime    @default(now())
}

model MetricsSnapshot {
  id            String      @id @default(cuid())
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  channel       String
  isReal        Boolean     @default(false) // true = live API, false = synthetic simulation
  impressions   Int         @default(0)
  reach         Int         @default(0)
  engagements   Int         @default(0)
  clicks        Int         @default(0)
  saves         Int         @default(0)
  shares        Int         @default(0)
  conversions   Int         @default(0)
  engagementRate Float      @default(0.0)
  snapshotDate  DateTime    @default(now())
}

model TrendSignal {
  id               String   @id @default(cuid())
  topic            String
  category         String
  summary          String
  source           String   @default("GDELT / Industry Intelligence")
  relevanceScore   Float
  freshnessScore   Float
  opportunityScore Float
  detectedAt       DateTime @default(now())
}

model Recommendation {
  id                String   @id @default(cuid())
  targetChannel     String
  bestPillar        String
  strongestHook     String
  recommendedTopic  String
  postingWindow     String
  cta               String
  explanation       String
  confidence        Float
  limitations       String
  appliedToCampaignId String?
  createdAt         DateTime @default(now())
}

model AgentRun {
  id                  String   @id @default(cuid())
  taskId              String
  agentName           String   // 'BrandContextAgent', 'StrategyAgent', 'CopywritingAgent', 'ReviewAgent', 'PublishingAgent', 'AnalyticsAgent', 'OptimizationAgent'
  status              String   // 'completed', 'needs_revision', 'blocked', 'failed'
  inputSummary        String
  outputSummary       String
  confidence          Float
  warningsJson        String?
  latencyMs           Int
  inputTokens         Int?
  outputTokens        Int?
  modelName           String   @default("gemini-2.5-flash")
  promptVersion       String   @default("v1.0")
  policyVersion       String   @default("v1.0")
  executedAt          DateTime @default(now())
}

model AuditEvent {
  id            String   @id @default(cuid())
  tenantId      String   @default("tenant-default")
  category      String   @default("System") // 'Authentication', 'Administration', 'Brand', 'Knowledge / RAG', 'Campaign', 'Agent Execution', 'AI / Model', 'Approval', 'Compliance', 'Content', 'Scheduling', 'Publishing', 'Connector', 'Analytics', 'Forecasting', 'Experiment', 'Optimization', 'Cost', 'Credential', 'Security', 'Incident', 'System'
  severity      String   @default("info")   // 'info', 'warning', 'critical'
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  brandId       String?
  brand         Brand?   @relation(fields: [brandId], references: [id])
  campaignId    String?
  campaign      Campaign? @relation(fields: [campaignId], references: [id])
  action        String   // e.g., 'BRAND_CREATED', 'DOCUMENT_UPLOADED', 'STRATEGY_GENERATED', 'CONTENT_GENERATED', 'REVIEW_PASSED', 'APPROVED', 'PUBLISHED_SIMULATED', 'PUBLISHED_LIVE'
  details       String
  entityType    String
  entityId      String
  correlationId String?
  metadataJson  String?
  createdAt     DateTime @default(now())
}

model PlatformConnection {
  id                    String    @id @default(cuid())
  brandId               String
  brand                 Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  platform              String    // 'linkedin', 'facebook', 'instagram', 'telegram'
  accountName           String
  accountId             String
  organizationId        String?
  encryptedAccessToken  String
  encryptedRefreshToken String?
  tokenExpiry           DateTime?
  scopes                String?
  status                String    @default("CONNECTED") // 'CONNECTED', 'DISCONNECTED', 'EXPIRED', 'ERROR'
  lastCheckedAt         DateTime  @default(now())
  lastError             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([brandId, platform])
}

model WorkflowInstance {
  id              String   @id @default(cuid())
  workflowId      String   @unique
  workflowName    String   // 'campaign-workflow', 'content-generation-workflow', 'approval-workflow', etc.
  tenantId        String   @default("tenant-default")
  brandId         String?
  campaignId      String?
  status          String   @default("RUNNING") // 'RUNNING', 'WAITING_APPROVAL', 'SCHEDULED_TIMER', 'COMPLETED', 'FAILED', 'CANCELLED'
  currentStep     String
  inputJson       String
  stateJson       String
  historyJson     String?
  errorDetails    String?
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ApprovalRequest {
  id                   String   @id @default(cuid())
  tenantId             String   @default("tenant-default")
  brandId              String
  campaignId           String?
  contentItemId        String
  oversightMode        String   @default("APPROVAL_REQUIRED") // 'COPILOT', 'APPROVAL_REQUIRED', 'RISK_BASED', 'AUTONOMOUS'
  riskCategory         String   @default("NORMAL")
  mandatoryApproval    Boolean  @default(true)
  mandatoryReason      String?
  assignedReviewerId   String?
  status               String   @default("PENDING") // 'PENDING', 'APPROVED', 'REJECTED', 'REVISION_REQUESTED'
  commentsJson         String?  // JSON array of comments [{reviewerId, comment, timestamp}]
  slaHours             Int      @default(24)
  concurrencyVersion   Int      @default(1)
  requestedAt          DateTime @default(now())
  decidedAt            DateTime?
  updatedAt            DateTime @updatedAt
}

model PublicationLedgerEntry {
  id                 String    @id @default(cuid())
  publicationId     String    @unique
  tenantId          String    @default("tenant-default")
  campaignId        String
  contentItemId     String
  contentVariantId  String
  platform          String    // 'linkedin', 'facebook', 'instagram', 'telegram'
  connectorAccountId String?
  idempotencyKey    String    @unique
  requestChecksum   String
  intendedSchedule  DateTime
  attemptCount      Int       @default(0)
  currentState      String    @default("PENDING") // 'PENDING', 'IN_FLIGHT', 'PUBLISHED', 'FAILED_TRANSIENT', 'FAILED_PERMANENT', 'RECONCILING'
  platformPostId    String?
  permalink         String?
  publishedAt       DateTime?
  reconciliationStatus String @default("OK") // 'OK', 'NEEDS_RECONCILIATION', 'RECONCILED'
  lastErrorDetails  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model DeadLetterItem {
  id               String   @id @default(cuid())
  tenantId         String   @default("tenant-default")
  publicationId   String?
  workflowId       String?
  platform         String
  errorCategory    String   // 'CREDENTIAL_EXPIRED', 'RATE_LIMIT_EXHAUSTED', 'PERMANENT_POLICY', 'NETWORK_TIMEOUT'
  errorMessage     String
  payloadJson      String
  retryCount       Int      @default(0)
  status           String   @default("OPEN") // 'OPEN', 'RESOLVED_MANUAL', 'RESOLVED_RETRY', 'DISCARDED'
  resolutionNote   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model CrisisPauseLog {
  id          String   @id @default(cuid())
  tenantId    String   @default("tenant-default")
  brandId     String
  campaignId  String?
  action      String   // 'PAUSED', 'RESUMED'
  reason      String
  initiatedBy String
  pausedAt    DateTime @default(now())
  resumedAt   DateTime?
}

model DomainEventRecord {
  id            String   @id @default(cuid())
  eventId       String   @unique
  eventVersion  String   @default("v1.0")
  eventType     String   // 'content.approved', 'publication.succeeded', etc.
  tenantId      String   @default("tenant-default")
  correlationId String
  causationId   String?
  producer      String
  payloadJson   String
  occurredAt    DateTime @default(now())
}

model NormalizedMetricEvent {
  id               String   @id @default(cuid())
  eventId          String   @unique
  tenantId         String   @default("tenant-default")
  brandId          String
  campaignId       String?
  contentId        String?
  contentVersionId String?
  publicationId    String?
  experimentId     String?
  platform         String   // 'linkedin', 'facebook', 'instagram', 'telegram', 'youtube', etc.
  eventType        String   // 'snapshot', 'conversion', 'interaction', 'correction'
  occurredAt       DateTime
  receivedAt       DateTime @default(now())
  metricsJson      String   // Normalized metrics (impressions, reach, reactions, comments, shares, saves, clicks, ctr, watchTime, videoCompletion, followerGrowth, leads, conversions, sentiment, responseTime, cpo)
  dimensionsJson   String?  // Dimensions (device, geography, demography, placement)
  source           String   @default("PLATFORM_API")
  schemaVersion    String   @default("v1.0")
  rawPayloadJson   String?
  dedupHash        String   @unique
  createdAt        DateTime @default(now())
}

model Experiment {
  id                   String   @id @default(cuid())
  tenantId             String   @default("tenant-default")
  brandId              String
  name                 String
  hypothesis           String
  primaryMetric        String
  guardrailMetricsJson String   // JSON array of metric names
  targetPopulation     String
  variantsJson         String   // JSON array of variant specs [{id, name, contentVariantId, weight, configJson}]
  assignmentMethod     String   @default("DETERMINISTIC_HASH") // 'DETERMINISTIC_HASH', 'BANDIT', 'HOLDOUT'
  startRulesJson       String
  stopRulesJson        String
  minSampleRequirements Int     @default(100)
  risksJson            String?
  status               String   @default("DRAFT") // 'DRAFT', 'RUNNING', 'PAUSED', 'CONCLUDED', 'CANCELLED'
  winnerVariantId      String?
  startDate            DateTime?
  endDate              DateTime?
  evaluatedAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  assignments ExperimentAssignment[]
}

model ExperimentAssignment {
  id             String     @id @default(cuid())
  experimentId   String
  experiment     Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  tenantId       String     @default("tenant-default")
  userIdOrSubjectId String
  variantId      String
  assignedAt     DateTime   @default(now())

  @@unique([experimentId, tenantId, userIdOrSubjectId])
}

model LearningMemoryItem {
  id                    String    @id @default(cuid())
  tenantId              String    @default("tenant-default")
  brandId               String
  learnedPreference     String
  supportingEvidenceJson String   // JSON array of evidence refs or experiment IDs
  confidence            Float
  scopeTenant           String    @default("tenant-default")
  scopeBrand            String
  scopeCampaignType     String?
  scopeAudience         String?
  scopeChannel          String?
  scopeLocale           String?
  expiry                DateTime?
  status                String    @default("PROPOSED") // 'PROPOSED', 'TEMPORARY_OBSERVATION', 'APPROVED_LEARNED_POLICY', 'ROLLED_BACK'
  approverId            String?
  rollbackRef           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model CostBudget {
  id                String   @id @default(cuid())
  tenantId          String   @unique
  monthlyBudgetUsd  Float    @default(500.0)
  campaignBudgetUsd Float    @default(100.0)
  taskTokenBudget   Int      @default(50000)
  mediaBudgetUsd    Float    @default(50.0)
  spentUsd          Float    @default(0.0)
  tokensUsed        Int      @default(0)
  updatedAt         DateTime @updatedAt
}

model CostUsageRecord {
  id               String   @id @default(cuid())
  tenantId         String   @default("tenant-default")
  brandId          String?
  campaignId       String?
  agentName        String
  modelName        String
  billingClass     String   @default("FREE") // 'FREE', 'PAID'
  billingSubtype   String   @default("mock_engine") // 'local_model', 'free_api_tier', 'promotional_credit', 'enterprise_included', 'token_billed', 'request_billed', 'media_billed'
  routingReason    String?
  tier             String   @default("STANDARD") // 'ECONOMY', 'STANDARD', 'PREMIUM'
  inputTokens      Int
  outputTokens     Int
  estimatedCostUsd Float
  actualCostUsd    Float
  isAnomaly        Boolean  @default(false)
  createdAt        DateTime @default(now())
}

model ApiCredential {
  id               String    @id @default(cuid())
  tenantId         String    @default("tenant-default")
  category         String    // 'ai', 'social', 'search', 'media', 'other'
  provider         String    // 'gemini', 'openai', 'anthropic', 'linkedin', 'telegram', 'serpapi', etc.
  name             String
  encryptedSecret  String    // JSON string containing AES-256-GCM encrypted payload
  keyMask          String    // e.g. "sk-•••••••••7X2A"
  configJson       String?   // Additional non-secret metadata
  status           String    @default("configured") // 'not_configured', 'configured', 'testing', 'connected', 'degraded', 'token_expiring', 'expired', 'permission_required', 'failed'
  lastTestedAt     DateTime?
  lastSuccessAt    DateTime?
  lastError        String?
  createdBy        String?
  updatedBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([tenantId, category, provider])
}

model PerformanceForecast {
  id                String    @id @default(cuid())
  tenantId          String    @default("tenant-default")
  brandId           String
  campaignId        String?
  contentItemId     String?
  publicationId     String?
  channel           String
  metric            String    // 'impressions', 'reach', 'engagements', 'ctr', etc.
  predictedValue    Float
  lowerBound        Float
  upperBound        Float
  confidence        String    // 'High', 'Medium', 'Low'
  dataSufficiency   String    // 'Sufficient', 'Sparse', 'ColdStart'
  baseline          Float
  expectedLift      Float
  modelVersion      String    @default("v1.0-forecast")
  keyFactorsJson    String?   // JSON array of factor objects
  actualValue       Float?
  evaluatedAt       DateTime?
  mae               Float?
  rmse              Float?
  mape              Float?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model CommunityMessage {
  id                 String    @id @default(cuid())
  tenantId           String    @default("tenant-default")
  brandId            String
  platform           String    // 'linkedin', 'facebook', 'instagram', 'telegram'
  externalMessageId  String    @unique
  senderHandle       String
  content            String
  classification     String    // 'POSITIVE', 'NEUTRAL', 'NEGATIVE', 'QUESTION', 'SUPPORT_REQUEST', 'SALES_LEAD', 'SPAM', 'ABUSE', 'SENSITIVE', 'CRISIS_RISK'
  suggestedResponse  String?
  isEscalated        Boolean   @default(false)
  escalationReason   String?
  status             String    @default("INBOX") // 'INBOX', 'DRAFTED', 'APPROVED_FOR_POSTING', 'POSTED', 'REJECTED'
  reviewedBy         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model LocalizedContent {
  id                      String   @id @default(cuid())
  tenantId                String   @default("tenant-default")
  sourceContentId         String
  sourceVariantId         String?
  locale                  String   // e.g., 'es-ES', 'fr-FR', 'de-DE', 'ja-JP'
  translatedHeadline      String?
  translatedBody          String
  translatedCTA           String
  transcreationNotes      String?
  lineageJson             String   // Source-to-localized tracking details
  isCulturallySensitive   Boolean  @default(false)
  policyValidationStatus  String   @default("PASSED") // 'PASSED', 'FLAGGED', 'NEEDS_REVIEW'
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model VideoPackage {
  id                        String   @id @default(cuid())
  tenantId                  String   @default("tenant-default")
  contentItemId             String
  hook                      String
  script                    String
  sceneSequenceJson         String   // JSON array of scene objects [{sceneNumber, durationSec, visualDescription, audioScript, textOverlay}]
  storyboardJson            String   // JSON array of storyboard frame directions
  brollSuggestionsJson      String   // JSON array of B-roll tags
  onScreenText              String
  voiceoverText             String
  subtitleCaptionContent    String
  thumbnailBrief            String
  durationEstimateSeconds   Int
  aspectRatiosJson          String   // JSON array of strings e.g. ["9:16", "1:1", "16:9"]
  safeAreaInstructions      String
  accessibilityNotes        String
  consistencyValidationJson String   // JSON object with score and issues
  renderingProviderStatus   String   @default("PREVIEW_GENERATED") // 'PREVIEW_GENERATED', 'QUEUED_RENDER', 'RENDERED', 'FAILED'
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model CreativeFatigueRecord {
  id             String   @id @default(cuid())
  tenantId       String   @default("tenant-default")
  brandId        String
  contentId      String
  fatigueType    String   // 'REPEATED_HOOK', 'NEAR_DUPLICATE_CAPTION', 'REPEATED_VISUAL', 'OVERUSED_CTA', 'DECLINING_ENGAGEMENT', 'EXCESSIVE_TOPIC_FREQ', 'EXPIRED_TREND', 'CHANNEL_OVERPOSTING'
  similarityScore Float
  explanation    String
  detectedAt     DateTime @default(now())
}

model BrandMergeRecord {
  id                 String   @id @default(cuid())
  tenantId           String   @default("tenant-default")
  canonicalBrandId   String
  mergedBrandId      String
  mergedBrandName    String
  mergedDomain       String?
  reason             String
  migratedCountsJson String   // JSON object detailing counts of migrated entities
  mergedBy           String   @default("system")
  mergedAt           DateTime @default(now())
}



